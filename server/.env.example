MONGODB_URI=
PORT=3005
# localhost on your own machine; 0.0.0.0 on a host, so it can reach the server
SERVER_HOST=localhost

# The address of the web app: links in emails point there
FRONTEND_URL=http://localhost:5179

# A long random text; logins are signed with it. A login lasts 7 days.
ACCESS_TOKEN_SECRET=

# "production" on a host: the login cookie is then sent over https only
NODE_ENV=development

# Live matches: a key from cricketdata.org (the free plan allows 100 requests a day).
# Without it the app shows its sample matches only.
CRICKET_API_KEY=
# Requests to the cricket source in a day (default 90)
# CRICKET_DAILY_BUDGET=

# Explanations of suggested teams: a Gemini API key. Without it teams come without text.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Explanations the whole site may ask for in a day (default 200), predictions a user
# may ask for in a day (default 20), teams an account may hold (default 50; the demo account 20)
# SITE_EXPLANATION_LIMIT=
# DAILY_PREDICTION_LIMIT=
# MAX_TEAMS=
# MAX_DEMO_TEAMS=

# Rebuild the demo account and its saved teams every time the server starts
SEED_ON_START=false

# Email, option 1: SMTP (works locally and on hosts that allow outgoing mail ports)
MAIL_HOST=
EMAIL_PORT=
MAIL_USER=
MAIL_PASS=

# Email, option 2: Brevo HTTPS API. When BREVO_API_KEY is set it is used instead of SMTP.
# MAIL_FROM must be a sender verified in Brevo; it defaults to MAIL_USER.
BREVO_API_KEY=
MAIL_FROM=

# How many mails the whole site may send in a day (default 250)
# DAILY_MAIL_LIMIT=

# Optional. Only on a host that puts proxies of its own in front of the server and
# reports the caller in a header the caller cannot set (Render: cf-connecting-ip).
# CONNECTION_IP_HEADER=
